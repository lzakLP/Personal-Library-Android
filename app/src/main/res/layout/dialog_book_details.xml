<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/detailBookCover"
            android:layout_width="112dp"
            android:layout_height="160dp"
            android:contentDescription="@string/book_cover"
            android:scaleType="centerInside"
            android:src="@drawable/book_cover_placeholder" />

        <TextView
            android:id="@+id/detailBookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/library_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailBookAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/library_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detailBookIsbn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/library_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/detailBookRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/library_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/notes_heading"
            android:textColor="@color/library_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailBookNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/library_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>